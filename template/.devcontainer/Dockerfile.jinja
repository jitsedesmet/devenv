{% if setup_type == "java" -%}
FROM maven:3.9-eclipse-temurin-21

# Install basic development tools
RUN apt update && apt install -y less man-db sudo curl nano

# This base image (Ubuntu Noble) already ships an `ubuntu` user at UID/GID
# 1000 — the same convention the Node.js image's `node` user follows — so it
# just needs `sudo` access, not creating from scratch. Reusing it (rather
# than useradd'ing a second UID 1000 user, which would fail outright since
# it's taken) also keeps the .claude/.copilot bind mounts writable, since
# UID/GID 1000 is typically the first Linux user on the host too.
ARG USERNAME={{ container_user }}
RUN echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# Ubuntu's /etc/bash.bashrc prints a "To run a command as administrator..."
# hint in every new shell until this file exists (it's normally created the
# first time you run sudo interactively); pre-create it so terminals open
# without that noise.
RUN touch /home/$USERNAME/.sudo_as_admin_successful \
    && chown $USERNAME:$USERNAME /home/$USERNAME/.sudo_as_admin_successful
{% else -%}
FROM node:22

# Install basic development tools
RUN apt update && apt install -y less man-db sudo curl nano

# Ensure default `node` user has access to `sudo`
ARG USERNAME={{ container_user }}
RUN echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME
{% endif %}
# Set `DEVCONTAINER` environment variable to help with orientation
ENV DEVCONTAINER=true

# Keep AI tools out of the commit history (and so out of GitHub's contributor
# list). Claude Code reads a system-wide managed settings file; ~/.claude
# can't be used because it's bind-mounted per project and would shadow
# anything baked into the image. `includeCoAuthoredBy` is deprecated but still
# honoured by older CLI versions. Copilot CLI has no such setting, so a global
# commit-msg hook strips its trailers (and Claude's, as a fallback).
RUN mkdir -p /etc/claude-code \
    && printf '%s\n' '{"attribution": {"commit": "", "pr": ""}, "includeCoAuthoredBy": false}' > /etc/claude-code/managed-settings.json
COPY --chmod=755 git-hooks/ /usr/local/share/git-hooks/

USER {{ container_user }}
RUN curl -fsSL https://gh.io/copilot-install | bash
RUN curl -fsSL https://claude.ai/install.sh | bash
RUN git config --global alias.gitm 'commit -am' \
    && git config --global push.autoSetupRemote true \
    && git config --global core.editor nano \
    && git config --global core.hooksPath /usr/local/share/git-hooks

# Plain scripts on PATH rather than shell aliases: an alias only fires in an
# interactive shell that sources ~/.bashrc, which isn't guaranteed for every
# terminal a JetBrains/VS Code devcontainer opens.
USER root
RUN printf '#!/bin/sh\nexec git commit -am "$@"\n' > /usr/local/bin/gitm \
    && printf '#!/bin/sh\nexec claude --dangerously-skip-permissions "$@"\n' > /usr/local/bin/claude-yolo \
    && printf '#!/bin/sh\nexec copilot --yolo "$@"\n' > /usr/local/bin/copilot-yolo \
    && chmod +x /usr/local/bin/gitm /usr/local/bin/claude-yolo /usr/local/bin/copilot-yolo
